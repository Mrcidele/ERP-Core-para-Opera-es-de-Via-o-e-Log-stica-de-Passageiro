APP_NAME="ERP FrotaCarga"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Fuso das datas nos CSVs exportados (a API e o banco usam UTC).
APP_REPORT_TIMEZONE=America/Sao_Paulo
# Em produção atrás de balanceador: IPs/faixas do proxy separados por vírgula, ou * se só o proxy alcança a aplicação.
TRUSTED_PROXIES=
# Documentação da API em /docs/api: sempre aberta em local/testing; nos demais ambientes, só com true.
SCRAMBLE_ENABLED=false

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

HASH_DRIVER=argon2id
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL serverless (Supabase ou Neon). Copie host, banco, usuário e senha do painel do provedor.
# Pode-se usar DB_URL com a string de conexão completa no lugar dos campos abaixo.
DB_CONNECTION=pgsql
DB_URL=
DB_HOST=
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require
# true ao conectar pelo pooler em modo transação (Supabase porta 6543, Neon com "-pooler" no host).
DB_EMULATE_PREPARES=false

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Validade do token de acesso da API, em minutos.
SANCTUM_TOKEN_EXPIRATION=480
